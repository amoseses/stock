<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Escaping the Australian Outback</title>
    <style>
        :root {
            --sand: #f7c96b;
            --sunset: #ff8f5f;
            --red-dirt: #b8542f;
            --dark: #2c2438;
            --paper: rgba(255, 248, 220, 0.92);
            --gold: #ffd84d;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            overflow: hidden;
            font-family: "Trebuchet MS", Arial, sans-serif;
            color: var(--dark);
            background:
                radial-gradient(circle at 78% 16%, #fff6b3 0 6%, transparent 7%),
                linear-gradient(#75c7f0 0%, #f8a35d 54%, #c96139 100%);
        }

        .game-shell {
            display: grid;
            grid-template-columns: 250px 1fr 250px;
            gap: 14px;
            height: 100vh;
            padding: 14px;
        }

        aside {
            display: flex;
            flex-direction: column;
            gap: 12px;
            min-width: 0;
        }

        .panel {
            padding: 14px;
            border: 3px solid rgba(92, 53, 34, 0.5);
            border-radius: 18px;
            background: var(--paper);
            box-shadow: 0 8px 0 rgba(78, 37, 20, 0.2);
        }

        h1, h2, h3, p { margin-top: 0; }
        h1 { margin-bottom: 8px; font-size: 24px; line-height: 1.05; }
        h2 { margin-bottom: 8px; font-size: 18px; }
        h3 { margin-bottom: 6px; font-size: 15px; }
        p, li { font-size: 14px; line-height: 1.35; }

        canvas {
            display: block;
            width: 100%;
            height: 100%;
            border: 5px solid rgba(83, 48, 27, 0.7);
            border-radius: 22px;
            background: #e89d4f;
            box-shadow: 0 12px 0 rgba(78, 37, 20, 0.25);
        }

        .stage { position: relative; min-width: 0; }

        .hint {
            position: absolute;
            left: 18px;
            right: 18px;
            bottom: 18px;
            padding: 10px 14px;
            border-radius: 999px;
            background: rgba(44, 36, 56, 0.85);
            color: white;
            font-size: 14px;
            text-align: center;
            pointer-events: none;
        }

        .character-card {
            display: grid;
            grid-template-columns: 44px 1fr;
            align-items: center;
            gap: 10px;
            padding: 8px;
            margin-bottom: 8px;
            border: 2px solid transparent;
            border-radius: 14px;
            background: rgba(255, 255, 255, 0.45);
            cursor: pointer;
        }

        .character-card.active {
            border-color: var(--gold);
            background: rgba(255, 216, 77, 0.25);
        }

        .mini-sprite {
            width: 36px;
            height: 44px;
            border-radius: 18px 18px 10px 10px;
            border: 3px solid rgba(44, 36, 56, 0.35);
            position: relative;
        }

        .mini-sprite::before {
            content: "";
            position: absolute;
            left: 8px;
            top: -13px;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #f0bd8f;
            border: 3px solid rgba(44, 36, 56, 0.35);
        }

        .dad { background: #74b7a3; }
        .finn { background: #b96bc4; }
        .mom { background: #8cc2f0; }
        .atti { background: #f5f7fb; }

        .letters {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 6px;
        }

        .letter {
            display: grid;
            place-items: center;
            min-height: 31px;
            border: 2px dashed rgba(92, 53, 34, 0.45);
            border-radius: 8px;
            color: transparent;
            font-weight: 900;
            background: rgba(255, 255, 255, 0.45);
        }

        .letter.found {
            color: #7a4c00;
            border-style: solid;
            border-color: #c08a00;
            background: linear-gradient(#fff6a8, #ffc53d);
            text-shadow: 0 1px white;
        }

        .inventory-list {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            padding: 0;
            list-style: none;
        }

        .inventory-list li {
            padding: 5px 8px;
            border-radius: 999px;
            background: #ffe3a5;
            border: 1px solid #d79635;
        }

        .objective-list { padding-left: 18px; }
        .objective-list li.done { text-decoration: line-through; opacity: 0.65; }

        .controls {
            margin-bottom: 0;
            font-size: 13px;
        }
    </style>
</head>
<body>
    <main class="game-shell">
        <aside>
            <section class="panel">
                <h1>Escaping the Australian Outback</h1>
                <p>Explore compact regions, collect survival gear, solve quick puzzles, and escape before sunset.</p>
                <p class="controls"><strong>Move:</strong> WASD / Arrows<br><strong>Interact:</strong> Space / Click<br><strong>Inventory:</strong> I</p>
            </section>

            <section class="panel">
                <h2>Family Characters</h2>
                <div id="characterCards"></div>
            </section>
        </aside>

        <section class="stage">
            <canvas id="game" width="980" height="640"></canvas>
            <div class="hint" id="hint">Pick a character, then walk to glowing tasks and press Space.</div>
        </section>

        <aside>
            <section class="panel">
                <h2>Mysterious Golden Relics</h2>
                <div class="letters" id="letters"></div>
            </section>

            <section class="panel">
                <h2>Journal</h2>
                <ul class="objective-list" id="objectives"></ul>
            </section>

            <section class="panel" id="inventoryPanel">
                <h2>Inventory</h2>
                <ul class="inventory-list" id="inventory"></ul>
            </section>
        </aside>
    </main>

<script>
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");
const hint = document.getElementById("hint");

const family = [
    { id: "dad", name: "Dad", role: "adventurous pilot", shirt: "#6fb6a3", hair: "#2f2a28", hat: "#3e3d43", glasses: true, x: 110, y: 430 },
    { id: "finn", name: "Finn", role: "trail scout", shirt: "#b569c4", hair: "#6f4f3f", hat: null, glasses: false, x: 165, y: 430 },
    { id: "mom", name: "Mom", role: "calm puzzle pro", shirt: "#8fc5ee", hair: "#6b513b", hat: "#d6d0bd", glasses: false, x: 220, y: 430 },
    { id: "atti", name: "Atti", role: "selfie-map hero", shirt: "#f7f9ff", hair: "#7b5b46", hat: null, glasses: false, x: 275, y: 430 }
];

const relicPhrase = "HAPPYFATHERSDAY";
const inventory = new Set(["Rope", "Compass"]);
let activeCharacter = family[0];
let inventoryOpen = true;

const tasks = [
    { x: 120, y: 210, icon: "📻", title: "Repair the radio", reward: "H", item: "Batteries", objective: "Find batteries and fix the radio." },
    { x: 305, y: 330, icon: "🌉", title: "Build crocodile bridge", reward: "A", item: "Bridge Planks", objective: "Repair the broken billabong bridge." },
    { x: 470, y: 230, icon: "🚰", title: "Start the water pump", reward: "P", item: "Water Bottle", objective: "Rotate pipes until clean water flows." },
    { x: 645, y: 365, icon: "🦘", title: "Recover stolen backpack", reward: "P", item: "Map Pieces", objective: "Sneak past bushes after the kangaroo." },
    { x: 790, y: 245, icon: "⛏️", title: "Open the mine passage", reward: "Y", item: "Lantern", objective: "Light the mine and move the cart." },
    { x: 850, y: 455, icon: "⛽", title: "Refuel the jeep", reward: "F", item: "Fuel Can", objective: "Collect hose, filter, and fuel." }
];

const regions = [
    { name: "Crash Site", x: 65, y: 120, w: 145, h: 145, color: "#d97f42" },
    { name: "Red Desert", x: 235, y: 245, w: 145, h: 150, color: "#c75a32" },
    { name: "Billabong", x: 410, y: 135, w: 145, h: 145, color: "#62b7a9" },
    { name: "Rocky Canyon", x: 585, y: 260, w: 145, h: 155, color: "#9f7354" },
    { name: "Abandoned Mine", x: 735, y: 140, w: 145, h: 145, color: "#6c5f59" },
    { name: "Ranger Station", x: 760, y: 395, w: 160, h: 145, color: "#8fb45d" }
];

function drawSprite(person, x, y, scale = 1, facing = 1) {
    ctx.save();
    ctx.translate(x, y);
    ctx.scale(scale * facing, scale);

    ctx.fillStyle = "rgba(0, 0, 0, 0.18)";
    ctx.beginPath();
    ctx.ellipse(0, 42, 20, 8, 0, 0, Math.PI * 2);
    ctx.fill();

    ctx.fillStyle = person.shirt;
    roundRect(-17, 2, 34, 42, 10);
    ctx.fill();

    ctx.fillStyle = "#f0bd8f";
    ctx.beginPath();
    ctx.arc(0, -15, 18, 0, Math.PI * 2);
    ctx.fill();

    ctx.fillStyle = person.hair;
    if (person.id === "finn" || person.id === "atti") {
        for (let i = -14; i <= 14; i += 7) {
            ctx.beginPath();
            ctx.arc(i, -30 + Math.abs(i) / 4, 8, 0, Math.PI * 2);
            ctx.fill();
        }
    } else {
        ctx.beginPath();
        ctx.arc(0, -28, 17, Math.PI, Math.PI * 2);
        ctx.fill();
    }

    if (person.hat) {
        ctx.fillStyle = person.hat;
        roundRect(-21, -36, 42, 8, 4);
        ctx.fill();
        roundRect(-14, -47, 28, 16, 5);
        ctx.fill();
    }

    ctx.fillStyle = "#263247";
    ctx.beginPath();
    ctx.arc(-6, -16, 2.2, 0, Math.PI * 2);
    ctx.arc(7, -16, 2.2, 0, Math.PI * 2);
    ctx.fill();

    if (person.glasses) {
        ctx.strokeStyle = "#111";
        ctx.lineWidth = 2;
        ctx.strokeRect(-13, -21, 10, 8);
        ctx.strokeRect(3, -21, 10, 8);
        ctx.beginPath();
        ctx.moveTo(-3, -17);
        ctx.lineTo(3, -17);
        ctx.stroke();
    }

    ctx.strokeStyle = "#8d4f3b";
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(1, -9, 7, 0.1, Math.PI - 0.1);
    ctx.stroke();

    ctx.strokeStyle = "#2c2438";
    ctx.lineWidth = 4;
    ctx.beginPath();
    ctx.moveTo(-10, 42);
    ctx.lineTo(-13, 58);
    ctx.moveTo(10, 42);
    ctx.lineTo(13, 58);
    ctx.stroke();
    ctx.restore();
}

function roundRect(x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
}

function drawWorld() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    const sky = ctx.createLinearGradient(0, 0, 0, canvas.height);
    sky.addColorStop(0, "#79c9f2");
    sky.addColorStop(0.55, "#f4a35b");
    sky.addColorStop(1, "#bf5634");
    ctx.fillStyle = sky;
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    ctx.fillStyle = "#ffe28a";
    ctx.beginPath();
    ctx.arc(840, 88, 42, 0, Math.PI * 2);
    ctx.fill();

    ctx.fillStyle = "#9d4d32";
    ctx.beginPath();
    ctx.moveTo(0, 535);
    ctx.bezierCurveTo(180, 445, 365, 560, 520, 490);
    ctx.bezierCurveTo(720, 400, 790, 520, 980, 455);
    ctx.lineTo(980, 640);
    ctx.lineTo(0, 640);
    ctx.fill();

    for (const region of regions) {
        ctx.fillStyle = region.color;
        roundRect(region.x, region.y, region.w, region.h, 22);
        ctx.fill();
        ctx.fillStyle = "rgba(255,255,255,0.78)";
        ctx.font = "bold 15px Trebuchet MS";
        ctx.fillText(region.name, region.x + 13, region.y + 26);
    }

    ctx.strokeStyle = "rgba(255, 230, 153, 0.82)";
    ctx.lineWidth = 12;
    ctx.lineCap = "round";
    ctx.beginPath();
    ctx.moveTo(125, 465);
    ctx.lineTo(305, 330);
    ctx.lineTo(470, 230);
    ctx.lineTo(645, 365);
    ctx.lineTo(790, 245);
    ctx.lineTo(850, 455);
    ctx.stroke();

    tasks.forEach((task, index) => {
        const completed = index < foundLetters.length;
        ctx.fillStyle = completed ? "rgba(255, 216, 77, 0.95)" : "rgba(255,255,255,0.85)";
        ctx.beginPath();
        ctx.arc(task.x, task.y, 29, 0, Math.PI * 2);
        ctx.fill();
        ctx.font = "26px serif";
        ctx.textAlign = "center";
        ctx.fillText(completed ? task.reward : task.icon, task.x, task.y + 9);
    });

    family.forEach(person => {
        const isActive = person.id === activeCharacter.id;
        drawSprite(person, person.x, person.y, isActive ? 1.15 : 0.95, 1);
        ctx.fillStyle = isActive ? "#ffe46b" : "white";
        ctx.font = "bold 13px Trebuchet MS";
        ctx.textAlign = "center";
        ctx.fillText(person.name, person.x, person.y + 76);
    });

    if (foundLetters.length >= tasks.length) {
        ctx.fillStyle = "rgba(44, 36, 56, 0.82)";
        roundRect(220, 42, 540, 86, 18);
        ctx.fill();
        ctx.fillStyle = "#ffd84d";
        ctx.font = "bold 36px Trebuchet MS";
        ctx.textAlign = "center";
        ctx.fillText("HAPPY FATHER'S DAY", 490, 96);
    }
}

const keys = {};
const foundLetters = [];

document.addEventListener("keydown", event => {
    keys[event.key] = true;
    if (event.key === "i" || event.key === "I") {
        inventoryOpen = !inventoryOpen;
        document.getElementById("inventoryPanel").style.display = inventoryOpen ? "block" : "none";
    }
    if (event.key === " ") interact();
});

document.addEventListener("keyup", event => keys[event.key] = false);
canvas.addEventListener("click", interact);

function update() {
    const speed = 3.4;
    let dx = 0;
    let dy = 0;
    if (keys.ArrowLeft || keys.a) dx -= speed;
    if (keys.ArrowRight || keys.d) dx += speed;
    if (keys.ArrowUp || keys.w) dy -= speed;
    if (keys.ArrowDown || keys.s) dy += speed;

    activeCharacter.x = Math.max(35, Math.min(canvas.width - 35, activeCharacter.x + dx));
    activeCharacter.y = Math.max(95, Math.min(canvas.height - 75, activeCharacter.y + dy));
}

function interact() {
    const next = tasks[foundLetters.length];
    if (!next) {
        hint.textContent = "The jeep roars to life and the golden relics reveal the surprise!";
        return;
    }

    const distance = Math.hypot(activeCharacter.x - next.x, activeCharacter.y - next.y);
    if (distance > 78) {
        hint.textContent = `Head to ${next.title.toLowerCase()} next.`;
        return;
    }

    foundLetters.push(next.reward);
    inventory.add(next.item);
    hint.textContent = `${activeCharacter.name} completed: ${next.title}. Found ${next.item} and a mysterious golden relic!`;
    renderUi();
}

function renderUi() {
    document.getElementById("characterCards").innerHTML = family.map(person => `
        <button class="character-card ${person.id === activeCharacter.id ? "active" : ""}" data-id="${person.id}">
            <span class="mini-sprite ${person.id}"></span>
            <span><strong>${person.name}</strong><br>${person.role}</span>
        </button>
    `).join("");

    document.querySelectorAll(".character-card").forEach(card => {
        card.addEventListener("click", () => {
            activeCharacter = family.find(person => person.id === card.dataset.id);
            renderUi();
        });
    });

    document.getElementById("letters").innerHTML = relicPhrase.split("").map((letter, index) =>
        `<span class="letter ${index < foundLetters.length ? "found" : ""}">${letter}</span>`
    ).join("");

    document.getElementById("objectives").innerHTML = tasks.map((task, index) =>
        `<li class="${index < foundLetters.length ? "done" : ""}">${task.objective}</li>`
    ).join("") + (foundLetters.length >= tasks.length ? `<li>Drive toward the sunset.</li>` : "");

    document.getElementById("inventory").innerHTML = [...inventory].map(item => `<li>${item}</li>`).join("");
}

function loop() {
    update();
    drawWorld();
    requestAnimationFrame(loop);
}

renderUi();
loop();
</script>
</body>
</html>
